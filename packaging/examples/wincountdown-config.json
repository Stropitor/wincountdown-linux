    "//ascii_rules2": "  - Keep all digits the same width (11 characters recommended)",
    "//ascii_rules3": "  - Invalid/missing digits automatically fall back to defaults",
    "//ascii_rules4": "",
    "//ascii_tip": "Tip: Test your changes with: wincountdown 10s",
